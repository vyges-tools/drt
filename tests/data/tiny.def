VERSION 5.8 ;
DIVIDERCHAR "/" ;
BUSBITCHARS "[]" ;
DESIGN tiny ;
UNITS DISTANCE MICRONS 1000 ;
DIEAREA ( 0 0 ) ( 4000 2400 ) ;
ROW row0 core 0 0 N DO 20 BY 1 STEP 200 0 ;
TRACKS Y 100 DO 12 STEP 200 LAYER M1 ;
TRACKS X 100 DO 20 STEP 200 LAYER M1 ;
TRACKS X 100 DO 20 STEP 200 LAYER M2 ;
TRACKS Y 100 DO 12 STEP 200 LAYER M2 ;
COMPONENTS 2 ;
- u1 BUF + PLACED ( 1000 0 ) N ;
- u2 BUF + PLACED ( 2400 0 ) N ;
END COMPONENTS
PINS 1 ;
- in + NET in + DIRECTION INPUT + USE SIGNAL
  + LAYER M2 ( -35 0 ) ( 35 140 )
  + PLACED ( 1100 2200 ) N ;
END PINS
NETS 2 ;
- in ( PIN in ) ( u1 A ) ;
- n1 ( u1 Y ) ( u2 A ) ;
END NETS
END DESIGN
